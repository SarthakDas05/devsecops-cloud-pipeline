[Unit]
Description=Linux Health Monitor & Observability Daemon for Cloud Run Microservice
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/health_monitor.sh "https://your-service-url.a.run.app/health"
Restart=always
RestartSec=5s
Environment=LOG_FILE=/var/log/service_health.log
Environment=CHECK_INTERVAL_SEC=5
Environment=LATENCY_THRESHOLD_SEC=1.5
StandardOutput=journal
StandardError=journal

# Resource and security limits
LimitNOFILE=65536
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
